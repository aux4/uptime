{
  "scope": "aux4",
  "name": "uptime",
  "version": "0.0.1",
  "description": "Monitor URL uptime from the command line — register URLs, probe them on a schedule, record status, and chart it",
  "license": "Apache-2.0",
  "git": "https://github.com/aux4/uptime",
  "tags": [
    "aux4",
    "uptime",
    "monitor",
    "status",
    "healthcheck",
    "chart"
  ],
  "dependencies": [
    "aux4/repository",
    "aux4/curl",
    "aux4/chart",
    "aux4/cron",
    "aux4/jobs",
    "aux4/config"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node",
      "linux:nodejs"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "uptime",
          "execute": [
            "profile:uptime"
          ],
          "help": {
            "text": "Monitor URL uptime: register URLs, probe them on a schedule, record status, and chart it."
          }
        }
      ]
    },
    {
      "name": "uptime",
      "commands": [
        {
          "name": "add",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs add value(*)"
          ],
          "help": {
            "text": "Register something to monitor: a URL (--url) or an arbitrary command (--command). For a URL, only --url is required and the name is derived from the host. For a command, --name is required and up is decided by the exit code (and optional --expect output match). Saved to the registry YAML file.",
            "variables": [
              {
                "name": "url",
                "text": "The URL to monitor (HTTP check). Provide this OR --command.",
                "default": ""
              },
              {
                "name": "command",
                "text": "A command to run as the check (command check) — a DB query, a script, any aux4 command. Up when it exits 0 (see --expect/--exit). Provide this OR --url.",
                "default": ""
              },
              {
                "name": "name",
                "text": "A short name for the monitor. Defaults to the URL host for --url; required for --command.",
                "default": ""
              },
              {
                "name": "expectedStatus",
                "text": "URL check: which HTTP responses count as up. Accepts an exact code (200), a class (2XX), a numeric range (200-402), or a comma-separated union (200-399,405). Anything else — including timeouts and connection failures — is down.",
                "default": "2XX"
              },
              {
                "name": "expect",
                "text": "Command check: an optional match on the command's output for it to count as up. Same notation as expectedStatus (200 / 2XX / 200-402), plus comparisons (>0, >=1, <100, =5), regex:<pattern>, or a plain substring.",
                "default": ""
              },
              {
                "name": "exit",
                "text": "Command check: the exit code that counts as up.",
                "default": "0"
              },
              {
                "name": "expectBody",
                "text": "URL check: an optional match on the response body for it to count as up (in addition to the status). Same notation as --expect (regex:<pattern>, a substring, or a numeric comparison). Triggers a body fetch only when set.",
                "default": ""
              },
              {
                "name": "header",
                "text": "URL check: a request header as 'Name: Value' (e.g. 'Authorization: Bearer …'). Repeatable — pass --header multiple times to send several. Stored in the registry.",
                "default": ""
              },
              {
                "name": "retention",
                "text": "Per-monitor retention in days — how long this monitor's checks are kept before auto-expiry (overrides check-all's --retention; 0 = keep forever).",
                "default": ""
              },
              {
                "name": "config",
                "text": "Scope the monitor under a named profile in the registry (config.<profile>). One file can hold several independent monitor sets.",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Registry YAML file that stores the monitors.",
                "default": "uptime.yaml"
              }
            ]
          }
        },
        {
          "name": "remove",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs remove value(*)"
          ],
          "help": {
            "text": "Remove a registered monitor from the registry YAML file.",
            "variables": [
              {
                "name": "name",
                "text": "The monitor name to remove (required)."
              },
              {
                "name": "configFile",
                "text": "Registry YAML file that stores the monitors.",
                "default": "uptime.yaml"
              },
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>).",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs list value(*)"
          ],
          "help": {
            "text": "List the registered monitors. Prints a table on a terminal, or a JSON array when piped.",
            "variables": [
              {
                "name": "configFile",
                "text": "Registry YAML file that stores the monitors.",
                "default": "uptime.yaml"
              },
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>).",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "check",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs check value(*)"
          ],
          "help": {
            "text": "Probe one monitor now and record the result. Exits non-zero when the monitor is down.",
            "variables": [
              {
                "name": "name",
                "text": "The monitor name to check (required)."
              },
              {
                "name": "timeout",
                "text": "Per-probe timeout in milliseconds; a slower response is recorded as down.",
                "default": "10000"
              },
              {
                "name": "configFile",
                "text": "Registry YAML file that stores the monitors.",
                "default": "uptime.yaml"
              },
              {
                "name": "db",
                "text": "aux4/repository database file where checks are stored.",
                "default": "~/.aux4.config/uptime.db"
              },
              {
                "name": "retention",
                "text": "Days to keep each check before it auto-expires (0 = keep forever). Older checks are hidden from reads and removable with `uptime prune`.",
                "default": "90"
              },
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>).",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "check-all",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs check-all value(*)"
          ],
          "help": {
            "text": "Probe every registered monitor and record each result. This is the command to schedule with `uptime schedule`. Always exits 0 so a single failing probe never aborts a scheduled run.",
            "variables": [
              {
                "name": "timeout",
                "text": "Per-probe timeout in milliseconds; a slower response is recorded as down.",
                "default": "10000"
              },
              {
                "name": "configFile",
                "text": "Registry YAML file that stores the monitors.",
                "default": "uptime.yaml"
              },
              {
                "name": "db",
                "text": "aux4/repository database file where checks are stored.",
                "default": "~/.aux4.config/uptime.db"
              },
              {
                "name": "retention",
                "text": "Days to keep each check before it auto-expires (0 = keep forever). Older checks are hidden from reads and removable with `uptime prune`.",
                "default": "90"
              },
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>).",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "status",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs status value(*)"
          ],
          "help": {
            "text": "Show the current up/down state, last response, and rolling uptime for one monitor or all of them. Prints a table on a terminal, or JSON when piped. Pass --chart to also draw the uptime strip for each monitor (titled by its name); omit --name to show them all.",
            "variables": [
              {
                "name": "name",
                "text": "Limit to a single monitor. Omit for all monitors.",
                "default": ""
              },
              {
                "name": "window",
                "text": "Rolling uptime window in days; also bounds how many stored checks are read (0 = all retained).",
                "default": "90"
              },
              {
                "name": "chart",
                "text": "Also render the uptime strip for each monitor in scope (titled by the monitor name). Inline in supported terminals, or to files with --output.",
                "default": "false"
              },
              {
                "name": "period",
                "text": "With --chart: aggregation, 'daily' or 'check'.",
                "default": "daily"
              },
              {
                "name": "days",
                "text": "With --chart and daily period: how many days the strip covers.",
                "default": "90"
              },
              {
                "name": "output",
                "text": "With --chart: save the strip(s) to a file instead of previewing inline. For multiple monitors the monitor name is inserted into the filename.",
                "default": ""
              },
              {
                "name": "theme",
                "text": "With --chart: visual theme, light or dark.",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Registry YAML file that stores the monitors.",
                "default": "uptime.yaml"
              },
              {
                "name": "db",
                "text": "aux4/repository database file where checks are stored.",
                "default": "~/.aux4.config/uptime.db"
              },
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>).",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "chart",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs chart value(*)"
          ],
          "help": {
            "text": "Render the uptime status strip. With --name it charts that one monitor; without --name it charts EVERY registered monitor — one strip each, titled by name — so you see them all. Previews inline in the terminal by default (Ghostty, Kitty, iTerm2); pass --output to save to file(s) instead (the monitor name is added to the filename when charting several). Uses the aux4/chart `uptime` type.",
            "variables": [
              {
                "name": "name",
                "text": "Chart a single monitor. Omit to chart every registered monitor (one strip each).",
                "default": ""
              },
              {
                "name": "period",
                "text": "Aggregation: 'daily' (one bar per day, uptime% = up/total that day) or 'check' (one bar per individual probe).",
                "default": "daily"
              },
              {
                "name": "days",
                "text": "Daily period: how many days the strip covers (oldest on the left, today on the right).",
                "default": "90"
              },
              {
                "name": "bars",
                "text": "Check period: how many of the most recent probes to show.",
                "default": "90"
              },
              {
                "name": "output",
                "text": "Where the chart goes: a file path (.png or .svg) saves it; '-' writes raw bytes to stdout; omitting it previews inline.",
                "default": ""
              },
              {
                "name": "width",
                "text": "Chart width in pixels.",
                "default": ""
              },
              {
                "name": "height",
                "text": "Chart height in pixels.",
                "default": ""
              },
              {
                "name": "theme",
                "text": "Visual theme: light or dark.",
                "default": ""
              },
              {
                "name": "format",
                "text": "Output format override: png or svg.",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Registry YAML file that stores the monitors.",
                "default": "uptime.yaml"
              },
              {
                "name": "db",
                "text": "aux4/repository database file where checks are stored.",
                "default": "~/.aux4.config/uptime.db"
              },
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>).",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "prune",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs prune value(*)"
          ],
          "help": {
            "text": "Physically delete expired checks (past their retention ttl) from the database to reclaim disk. Expired checks are already hidden from reads; this removes them for good.",
            "variables": [
              {
                "name": "db",
                "text": "aux4/repository database file where checks are stored.",
                "default": "~/.aux4.config/uptime.db"
              }
            ]
          }
        },
        {
          "name": "start",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs start value(*)"
          ],
          "help": {
            "text": "Start the uptime scheduler — the aux4/cron daemon (on a dedicated port) that runs the scheduled checks. Idempotent. Run this once, and again after a machine reboot, so scheduled checks keep firing.",
            "variables": [
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>); also selects a per-profile `port` if set.",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Registry YAML file (used to source the scheduler `port`).",
                "default": "uptime.yaml"
              },
              {
                "name": "port",
                "text": "Scheduler cron daemon port. Defaults to a `port` value in the registry (per --config profile), else 8422. Override to run on a specific port (e.g. to share an existing cron daemon).",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs stop value(*)"
          ],
          "help": {
            "text": "Stop the uptime scheduler daemon. Scheduled checks stop firing; the schedule entries persist and resume when you start it again. Only affects uptime's scheduler, not other aux4/cron jobs.",
            "variables": [
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>); also selects a per-profile `port` if set.",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Registry YAML file (used to source the scheduler `port`).",
                "default": "uptime.yaml"
              },
              {
                "name": "port",
                "text": "Scheduler cron daemon port. Defaults to a `port` value in the registry (per --config profile), else 8422. Override to run on a specific port (e.g. to share an existing cron daemon).",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "schedule",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs schedule value(*)"
          ],
          "help": {
            "text": "Schedule recurring `check-all` runs via aux4/cron. Starts the uptime scheduler if needed and registers a job named 'uptime-check' (per-profile when --config is used). After a machine reboot, run `aux4 uptime start` to bring the scheduler back up.",
            "variables": [
              {
                "name": "interval",
                "text": "How often to probe, e.g. '5 min', '2 hours', '30s'.",
                "default": "5 min"
              },
              {
                "name": "configFile",
                "text": "Registry YAML file that stores the monitors.",
                "default": "uptime.yaml"
              },
              {
                "name": "db",
                "text": "aux4/repository database file where checks are stored.",
                "default": "~/.aux4.config/uptime.db"
              },
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>).",
                "default": ""
              },
              {
                "name": "port",
                "text": "Scheduler cron daemon port. Defaults to a `port` value in the registry (per --config profile), else 8422. Override to run on a specific port (e.g. to share an existing cron daemon).",
                "default": ""
              },
              {
                "name": "pruneEvery",
                "text": "How often to auto-prune expired checks, e.g. '1 day' (default). Set to '' or 'off' to disable the prune job.",
                "default": "1 day"
              }
            ]
          }
        },
        {
          "name": "unschedule",
          "execute": [
            "node ${packageDir}/lib/uptime.mjs unschedule value(*)"
          ],
          "help": {
            "text": "Remove the recurring 'uptime-check' schedule from aux4/cron.",
            "variables": [
              {
                "name": "config",
                "text": "Scope to a named profile in the registry (config.<profile>); also selects a per-profile `port` if set.",
                "default": ""
              },
              {
                "name": "configFile",
                "text": "Registry YAML file (used to source the scheduler `port`).",
                "default": "uptime.yaml"
              },
              {
                "name": "port",
                "text": "Scheduler cron daemon port. Defaults to a `port` value in the registry (per --config profile), else 8422. Override to run on a specific port (e.g. to share an existing cron daemon).",
                "default": ""
              }
            ]
          }
        }
      ]
    }
  ]
}
